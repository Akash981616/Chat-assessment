PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/chat_app
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ALLOWED_ORIGINS=http://localhost:3000
FIREBASE_PROJECT_ID=chat-backend-local
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
FIRESTORE_MESSAGES_COLLECTION=messages
FIRESTORE_RECEIPTS_COLLECTION=messageReceipts
FIRESTORE_LAST_SEEN_COLLECTION=chatLastSeen
FIRESTORE_OUTBOX_COLLECTION=messageDeliveryOutbox
# For Docker Compose local development only. Omit this when using Firebase in production.
FIRESTORE_EMULATOR_HOST=localhost:8080
