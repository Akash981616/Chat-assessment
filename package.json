{
  "name": "chat-backend",
  "version": "1.0.0",
  "private": true,
  "description": "A typed 1:1 chat API using PostgreSQL and Firebase Firestore.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "dev:worker": "tsx watch src/worker.ts",
    "check:retry": "node scripts/check-retry-policy.mjs",
    "test:api": "node scripts/api-smoke-test.mjs",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test": "npm run lint && npm run build && npm run check:retry && npm run test:smoke"
  },
  "engines": { "node": ">=22" },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase-admin": "^14.5.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "pg": "^8.13.1",
    "redis": "^4.7.0",
    "socket.io": "^4.8.1",
    "jsonwebtoken": "^9.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "socket.io-client": "^4.8.1",
    "@types/pg": "^8.11.10",
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "tsx": "^4.19.2",
    "typescript-eslint": "^8.0.0",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
